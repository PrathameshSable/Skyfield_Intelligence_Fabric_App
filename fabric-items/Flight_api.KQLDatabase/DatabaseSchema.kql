.create-merge table Flights (icao24:string, callsign:string, originCountry:string, longitude:real, latitude:real, geoAltitude:real, baroAltitude:real, velocity:real, heading:real, verticalRate:real, onGround:bool, lastContact:datetime, ingestedAt:datetime, originLat:real, originLon:real, originIata:string, destLat:real, destLon:real, destIata:string, airline:string, manufacturer:string, aircraftType:string) 
.create-or-alter table Flights ingestion json mapping 'FlightsJson'
