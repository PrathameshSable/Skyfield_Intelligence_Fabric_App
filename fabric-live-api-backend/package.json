{
  "name": "fabric-live-api-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend service that ingests an external live REST API, streams events into a Microsoft Fabric Eventstream/Eventhouse, and exposes a write-back API for a Fabric (Rayfin) data app.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@azure/event-hubs": "^5.12.0",
    "@azure/identity": "^4.5.0",
    "azure-kusto-data": "^6.0.2",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "mssql": "^11.0.1",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/mssql": "^9.1.7",
    "@types/node": "^22.10.5",
    "pino-pretty": "^13.0.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
